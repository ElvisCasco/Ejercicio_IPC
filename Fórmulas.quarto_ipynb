   "source": [
    "# Ponderaciones por productos\n",
    "conn.execute(\n",
    "    \"\"\"\n",
    "    INSTALL spatial;\n",
    "    LOAD spatial;\n",
    "    CREATE OR REPLACE TABLE ponderaciones AS\n",
    "    SELECT Estructura,Código,CCIF,Región AS Region,Pond_IPC\n",
    "    FROM st_read(\n",
    "        'Categorias.xlsx',\n",
    "        layer = 'IPC_Calc',\n",
    "        open_options = ['HEADERS=FORCE']);\n",
    "    \"\"\").pl()\n",
    "conn.execute(\n",
    "    \"\"\"\n",
    "    COPY\n",
    "        (SELECT * \n",
    "        FROM ponderaciones)\n",
    "        TO 'data/ponderaciones.parquet'\n",
    "        (FORMAT 'parquet');\n",
    "    FROM ponderaciones\n",
    "    \"\"\").pl()"
   ]
  },

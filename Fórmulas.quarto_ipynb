   ],
   "source": [
    "# IPC por productos\n",
    "conn.execute(\n",
    "    \"\"\"\n",
    "    CREATE OR REPLACE TABLE indices_g_producto AS\n",
    "    SELECT Código,\n",
    "    sum(I_p * Pond_IPC) / sum(Pond_IPC) AS I_b,\n",
    "    sum(Pond_IPC) AS w_b,\n",
    "    FROM indices_producto\n",
    "    GROUP BY Código\n",
    "    ORDER BY Código\n",
    "    \"\"\")\n",
    "conn.execute(\n",
    "    \"\"\"\n",
    "    COPY\n",
    "        (SELECT * \n",
    "        FROM indices_g_producto)\n",
    "        TO 'data/indices_g_producto.parquet'\n",
    "        (FORMAT 'parquet');\n",
    "    FROM indices_g_producto\n",
    "    \"\"\").pl()\n",
    "conn.execute(\n",
    "    \"\"\"\n",
    "    COPY\n",
    "        (SELECT * \n",
    "        FROM indices_g_producto)\n",
    "        TO 'data/indices_g_producto.csv'\n",
    "        (FORMAT 'csv');\n",
    "    FROM indices_g_producto\n",
    "    \"\"\").pl()"
   ]
  },

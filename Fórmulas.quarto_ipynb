   "source": [
    "import duckdb\n",
    "conn = duckdb.connect(database=':memory:')\n",
    "# Calcular precios e índices, por variedad y establecimiento\n",
    "conn.execute(\n",
    "    \"\"\"\n",
    "    CREATE OR REPLACE TABLE variedades AS\n",
    "    SELECT *,\n",
    "    -- Precios = Precio_Unitario * Contenido\n",
    "    Precio_Unitario_t_1 / Contenido_t_1 AS Precio_t_1,\n",
    "    Precio_Unitario_t / Contenido_t AS Precio_t,\n",
    "    -- I_c = Precio_t / Preci_t_1\n",
    "    Precio_t / Precio_t_1 AS I_c,\n",
    "    FROM \"data/precios_all.parquet\"\n",
    "    \"\"\")\n",
    "# Guardar en archivo .parquet\n",
    "conn.execute(\n",
    "    \"\"\"\n",
    "    COPY\n",
    "        (SELECT * \n",
    "        FROM variedades)\n",
    "        TO 'data/precios_all.parquet'\n",
    "        (FORMAT 'parquet');\n",
    "    FROM variedades\n",
    "    \"\"\").pl()\n",
    "conn.execute(\n",
    "    \"\"\"\n",
    "    COPY\n",
    "        (SELECT * \n",
    "        FROM variedades)\n",
    "        TO 'data/precios_all.csv'\n",
    "        (FORMAT 'csv');\n",
    "    FROM variedades\n",
    "    \"\"\").pl()"
   ]
  },

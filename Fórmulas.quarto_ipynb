   ],
   "source": [
    "# Índices por variedad, media geométrica\n",
    "conn.execute(\n",
    "    \"\"\"\n",
    "    CREATE OR REPLACE TABLE indices_variedades AS\n",
    "    SELECT Region,Variedad,--,Codigo,\n",
    "    array_slice(Variedad,1,8) AS Código,\n",
    "    geomean(I_c) * 100 AS I_v,\n",
    "    FROM variedades\n",
    "    GROUP BY Region,Variedad--,Codigo\n",
    "    ORDER BY Region,Variedad--,Codigo\n",
    "    \"\"\")\n",
    "# Guardar en archivo .parquet\n",
    "conn.execute(\n",
    "    \"\"\"\n",
    "    COPY\n",
    "        (SELECT * \n",
    "        FROM indices_variedades)\n",
    "        TO 'data/indices_variedades.parquet'\n",
    "        (FORMAT 'parquet');\n",
    "    FROM indices_variedades\n",
    "    \"\"\").pl()\n",
    "conn.execute(\n",
    "    \"\"\"\n",
    "    COPY\n",
    "        (SELECT * \n",
    "        FROM indices_variedades)\n",
    "        TO 'data/indices_variedades.csv'\n",
    "        (FORMAT 'csv');\n",
    "    FROM indices_variedades\n",
    "    \"\"\").pl()"
   ]
  },

       "│ Producto   ┆ 01111201 ┆ Arroz clasificado    ┆ MDC    ┆ … ┆ 011   ┆ 0111  ┆ 01111    ┆ 011112    │\n",
       "│ Producto   ┆ 01111601 ┆ Maíz en grano o      ┆ MDC    ┆ … ┆ 011   ┆ 0111  ┆ 01111    ┆ 011116    │\n",
       "│            ┆          ┆ desgranado           ┆        ┆   ┆       ┆       ┆          ┆           │\n",
       "│ Producto   ┆ 01112101 ┆ Harina de trigo      ┆ MDC    ┆ … ┆ 011   ┆ 0111  ┆ 01112    ┆ 011121    │\n",
       "│ Producto   ┆ 01112601 ┆ Harina de maíz       ┆ MDC    ┆ … ┆ 011   ┆ 0111  ┆ 01112    ┆ 011126    │\n",
       "│ Producto   ┆ 01113101 ┆ Bollito de yema pan  ┆ MDC    ┆ … ┆ 011   ┆ 0111  ┆ 01113    ┆ 011131    │\n",
       "│            ┆          ┆ dulce                ┆        ┆   ┆       ┆       ┆          ┆           │\n",
       "│ …          ┆ …        ┆ …                    ┆ …      ┆ … ┆ …     ┆ …     ┆ …        ┆ …         │\n",
       "│ Producto   ┆ 06410106 ┆ Radiografía          ┆ US     ┆ … ┆ 064   ┆ 0641  ┆ 06410    ┆ 064101    │\n",
       "│ Producto   ┆ 06410110 ┆ Tomografía (TAC,     ┆ US     ┆ … ┆ 064   ┆ 0641  ┆ 06410    ┆ 064101    │\n",
       "│            ┆          ┆ PET)                 ┆        ┆   ┆       ┆       ┆          ┆           │\n",
       "│ Producto   ┆ 06410111 ┆ Ultrasonido o        ┆ US     ┆ … ┆ 064   ┆ 0641  ┆ 06410    ┆ 064101    │\n",
       "│            ┆          ┆ ecografía            ┆        ┆   ┆       ┆       ┆          ┆           │\n",
       "│ Producto   ┆ 06410208 ┆ Examen de hemograma  ┆ US     ┆ … ┆ 064   ┆ 0641  ┆ 06410    ┆ 064102    │\n",
       "│            ┆          ┆ completo (…          ┆        ┆   ┆       ┆       ┆          ┆           │\n",
       "│ Producto   ┆ 06410211 ┆ Examen de la vista   ┆ US     ┆ … ┆ 064   ┆ 0641  ┆ 06410    ┆ 064102    │\n",
       "└────────────┴──────────┴──────────────────────┴────────┴───┴───────┴───────┴──────────┴───────────┘"
      ]
     },
     "execution_count": 101,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# Índices por producto, media geométrica\n",
    "conn.execute(\n",
    "    \"\"\"\n",
    "    CREATE OR REPLACE TABLE indices_producto AS\n",
    "    SELECT Region,Código,--,Codigo,\n",
    "    geomean(I_v) AS I_p,\n",
    "    array_slice(Código,1,2) AS Division,\n",
    "    array_slice(Código,1,3) AS Grupo,\n",
    "    array_slice(Código,1,4) AS Clase,\n",
    "    array_slice(Código,1,5) AS SubClase,\n",
    "    array_slice(Código,1,6) AS Categoria,\n",
    "    FROM indices_variedades\n",
    "    GROUP BY Region,Código--,Codigo\n",
    "    ORDER BY Region,Código--,Codigo\n",
    "    \"\"\")\n",
    "conn.execute(\n",
    "    \"\"\"\n",
    "    CREATE OR REPLACE TABLE indices_producto AS\n",
    "    SELECT *\n",
    "    FROM ponderaciones\n",
    "    JOIN indices_producto\n",
    "    USING (Código,Region),\n",
    "    ORDER BY Region,Código--,Codigo\n",
    "    \"\"\")\n",
    "# Guardar en archivo .parquet\n",
    "conn.execute(\n",
    "    \"\"\"\n",
    "    COPY\n",
    "        (SELECT * \n",
    "        FROM indices_producto)\n",
    "        TO 'data/indices_producto.parquet'\n",
    "        (FORMAT 'parquet');\n",
    "    FROM indices_producto\n",
    "    ORDER BY Código,Region\n",
    "    \"\"\").pl()\n",
    "conn.execute(\n",
    "    \"\"\"\n",
    "    COPY\n",
    "        (SELECT * \n",
    "        FROM indices_producto)\n",
    "        TO 'data/indices_producto.csv'\n",
    "        (FORMAT 'csv');\n",
    "    FROM indices_producto\n",
    "    \"\"\").pl()"
   ]
  },
